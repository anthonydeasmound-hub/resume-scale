{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/send-follow-ups",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "src/app/api/resume/preview-html/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/resume/save/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/jobs/*/generate/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/ai/*/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/review-resume/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/generate-resume-pdf/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/generate-cover-letter-pdf/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/jobs/*/interview-guide/pdf/route.ts": {
      "maxDuration": 60
    }
  }
}
