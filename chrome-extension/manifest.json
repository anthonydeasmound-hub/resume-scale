{
  "manifest_version": 3,
  "name": "ResumeGenie Job Saver",
  "version": "1.2.0",
  "description": "Save job listings to ResumeGenie with one click and auto-fill applications",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "tabs"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://resumegenie.careers/*",
    "http://localhost:3000/*",
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://www.indeed.com/*",
    "https://indeed.com/*",
    "https://www.glassdoor.com/*",
    "https://glassdoor.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://resumegenie.careers/*",
        "http://localhost:3000/*"
      ],
      "js": ["content-resumegenie.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://linkedin.com/jobs/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    },
    {
      "matches": [
        "https://www.linkedin.com/in/*",
        "https://linkedin.com/in/*"
      ],
      "js": ["profile-import.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.indeed.com/*",
        "https://indeed.com/*"
      ],
      "js": ["content-indeed.js"],
      "css": ["content.css"]
    },
    {
      "matches": [
        "https://www.glassdoor.com/*",
        "https://glassdoor.com/*"
      ],
      "js": ["content-glassdoor.js"],
      "css": ["content.css"]
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*",
        "https://resumegenie.careers/*",
        "http://localhost:3000/*"
      ],
      "js": ["content-autofill.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
